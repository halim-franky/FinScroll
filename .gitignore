# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Sensitive / secret files — NEVER commit these ────────────────────
# All environment files (API keys, secrets, tokens)
.env
.env.*
.env.local
.env.development
.env.production
.env.staging
*.env

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
id_rsa
id_ed25519

# Clerk, Supabase, or other auth credential files
clerk.json
supabase/.env

# ── Vercel / deployment ───────────────────────────────────────────────
.vercel

# ── TypeScript build artifacts ────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── OS artifacts ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor / IDE ──────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
