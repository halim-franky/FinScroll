# Why legacy-peer-deps=true:
#   @langchain/pinecone@1.0.2 lists @pinecone-database/pinecone@^5.0.2 as a
#   peer dep, but our direct dep is on @pinecone-database/pinecone@^7.2.0.
#   Newer npm refuses to resolve this without `--legacy-peer-deps`, breaking
#   Vercel + CI installs. Pinecone v7 is API-compatible with the v5 calls
#   LangChain makes, so this is safe in practice — we just need npm to
#   stop blocking the install.
#
# Committing this to git means every dev + every CI / Vercel build gets the
# same install behaviour automatically, no per-environment config needed.
legacy-peer-deps=true
